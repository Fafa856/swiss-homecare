# Copy this file to .env.local and fill in real values for local testing.
# In production, set these same names in Vercel → Project → Settings →
# Environment Variables instead (never commit real secrets to git).

# Supabase project settings → API
SUPABASE_URL=https://.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) → API Keys
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=hello@swisshome.care
RESEND_FROM_EMAIL="Swiss Homecare <hello@swisshome.care>"
